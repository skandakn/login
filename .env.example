# Copy only the variables required by the selected integration into the target app.
# Never commit a real .env file, secret key, token, or credential.

# Next.js App Router
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# React + Vite or vanilla JavaScript
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Express backend
# CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# CLERK_SECRET_KEY=sk_test_replace_me

# Standalone Python/PHP backend token verification, only if the chosen
# verification architecture requires it. Prefer the official Clerk docs/JWKS.
# CLERK_JWT_KEY=replace_with_verification_key
# CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"
